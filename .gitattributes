# 统一行尾为 LF，避免 Windows 与 macOS/Linux 协作时产生整文件 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.xpi binary

# 锁文件在 GitHub 上折叠显示，减少评审噪音
package-lock.json linguist-generated=true

# 第三方产物标记为 vendored，不计入仓库语言统计
libs/acorn.js linguist-vendored
libs/jsQR.js linguist-vendored
