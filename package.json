{
  "name": "toolcube",
  "version": "1.3.0",
  "description": "ToolCube：86 个纯本地工具 + 可插拔外部服务端点，支持接入自建服务器",
  "main": "background.js",
  "type": "module",
  "scripts": {
    "test": "node tools/_test-all.mjs",
    "lint": "web-ext lint --source-dir . --ignore-files \"node_modules/**\" --ignore-files \"tools/_*\" --ignore-files \"docs\" --ignore-files \"docs/**\" --ignore-files \"**/*.md\" --ignore-files \"LICENSE\" --ignore-files \".gitignore\" --ignore-files \"package-lock.json\" --ignore-files \"package.json\" --ignore-files \"libs/package.json\"",
    "start": "web-ext run --source-dir . --ignore-files \"node_modules/**\" --ignore-files \"tools/_*\" --ignore-files \"docs\" --ignore-files \"docs/**\"",
    "build": "web-ext build --source-dir . --overwrite-dest --filename \"toolcube-{version}.zip\" --ignore-files \"node_modules/**\" --ignore-files \"tools/_*\" --ignore-files \"docs\" --ignore-files \"docs/**\" --ignore-files \"**/*.md\" --ignore-files \"LICENSE\" --ignore-files \".gitignore\" --ignore-files \"package-lock.json\" --ignore-files \"package.json\" --ignore-files \"libs/package.json\""
  },
  "keywords": [
    "browser-extension",
    "webextension",
    "manifest-v3",
    "firefox-addon",
    "toolcube",
    "developer-tools",
    "dns-over-https",
    "self-hosted"
  ],
  "homepage": "https://github.com/l1111118/ToolCube#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l1111118/ToolCube.git"
  },
  "bugs": {
    "url": "https://github.com/l1111118/ToolCube/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "web-ext": "^10.5.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
